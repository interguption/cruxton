    "DEC-why-has-three-layers": {
      "title": "A record's 'why' has three layers, and non-derivable human reasoning rides at the top",
      "kind": "engineering",
      "status": "accepted",
      "binding": false,
      "placement": "area",
      "areas": [
        "method"
      ],
      "human_input": true,
      "human_crux": "PS's core addition: capture the human/subjective reasoning a machine cannot re-derive \u2014 instinct, a market read, an org constraint \u2014 and surface it high, so an agent won't confidently re-derive a decision whose real driver was human judgment. Machine logic is the re-derivable part; the human part is the scarce one.",
